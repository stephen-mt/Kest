# Local development only. Copy to .env before make start.
# Use URL-safe database credentials (letters, digits, underscores).

# PostgreSQL live source
POSTGRES_SOURCE_IMAGE=postgres:16@sha256:f1c3376c26f2609ab9f29f71f824103fe2fcd8ee0346485cb6122a4f93df6f94
POSTGRES_SOURCE_DB=kest_source
POSTGRES_SOURCE_USER=kest_source
POSTGRES_SOURCE_PASSWORD=change_me_source

# PostgreSQL Airflow metadata
POSTGRES_AIRFLOW_IMAGE=postgres:16@sha256:f1c3376c26f2609ab9f29f71f824103fe2fcd8ee0346485cb6122a4f93df6f94
POSTGRES_AIRFLOW_DB=airflow
POSTGRES_AIRFLOW_USER=airflow
POSTGRES_AIRFLOW_PASSWORD=change_me_airflow_db

# PostgreSQL Lakekeeper metadata
POSTGRES_CATALOG_IMAGE=postgres:16@sha256:f1c3376c26f2609ab9f29f71f824103fe2fcd8ee0346485cb6122a4f93df6f94
POSTGRES_CATALOG_DB=lakekeeper
POSTGRES_CATALOG_USER=lakekeeper
POSTGRES_CATALOG_PASSWORD=change_me_catalog_db

# MinIO
MINIO_IMAGE=minio/minio@sha256:14cea493d9a34af32f524e538b8346cf79f3321eff8e708c1e2960462bd8936e
MINIO_ROOT_USER=kest_minio
MINIO_ROOT_PASSWORD=change_me_minio
MINIO_BUCKET=mini-cybet

# Lakekeeper
LAKEKEEPER_IMAGE=quay.io/lakekeeper/catalog@sha256:4749ee267a4524502f9786e3f7eb8d34c8fe2a7b316d232bab80ca47563d7c68
LAKEKEEPER_PG_ENCRYPTION_KEY=change_me_catalog_encryption_key
LAKEKEEPER_WAREHOUSE=kest-local

# Workload and local lakehouse tools
WORKLOAD_EVENT_RATE=20
WORKLOAD_RANDOM_SEED=20260909
CDC_SLOT_NAME=kest_landing
CDC_BATCH_SIZE=500
CDC_POLL_INTERVAL_SECONDS=1
CDC_LANDING_PREFIX=landing/postgres-source
BRONZE_PREFIX=bronze/history
BRONZE_TARGET_BYTES=5368709120
ICEBERG_PREFIX=iceberg
SILVER_NAMESPACE=silver
GOLD_NAMESPACE=gold
BATCH_DUCKDB_MEMORY=1GB

# RisingWave: local SQLite metadata and filesystem state in one volume
RISINGWAVE_IMAGE=risingwavelabs/risingwave@sha256:f1151ed08411e40f77a43151096cd5c9734103e961af5b93b9cc7dca31805c35
RISINGWAVE_TOTAL_MEMORY_BYTES=1073741824
RISINGWAVE_PARALLELISM=1

# Airflow
AIRFLOW_IMAGE=apache/airflow@sha256:96e99f25815f533b298a4d53f283adf5c84c27334ea16ef232777cb800bddf10
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me_airflow_ui
AIRFLOW_FERNET_KEY=replace_with_a_generated_fernet_key
AIRFLOW_JWT_SECRET=change_me_airflow_jwt_secret

# Optional ingestion and shared SQL profile (`make platform-up`)
NIFI_IMAGE=apache/nifi:2.11.0@sha256:337e5122b0785e712050c609f5722155656b64908666340878f397a06f70fe4a
NIFI_SENSITIVE_PROPS_KEY=change_me_nifi_sensitive_properties_key
NIFI_USERNAME=admin
NIFI_PASSWORD=change_me_nifi_password_at_least_12_chars
INGESTION_SOURCE_NAME=postgres-source
INGESTION_HTTP_PATH=cdc/postgres-source
NIFI_LISTENER_PORT=9090
DEBEZIUM_SERVER_IMAGE=quay.io/debezium/server:3.6.2.Final@sha256:1b5807e96d612889703e43a978273525c1d042944595852080f55dc61dfc5355
DEBEZIUM_DATABASE_HOSTNAME=postgres-source
DEBEZIUM_DATABASE_PORT=5432
DEBEZIUM_TOPIC_PREFIX=kest-postgres
DEBEZIUM_SLOT_NAME=kest_nifi
DEBEZIUM_PUBLICATION_NAME=kest_nifi
DEBEZIUM_TABLE_INCLUDE_LIST=ingestion_demo.cdc_probe
TRINO_IMAGE=trinodb/trino:483@sha256:fca43d1fdfdcd45f36b791f7117a47f8ce69c58232e5398bfdb8539cd28e778b

# DeliveryOps production-like scenario
DELIVERY_POSTGRES_DB=delivery_ops
DELIVERY_POSTGRES_USER=delivery_ops
DELIVERY_POSTGRES_PASSWORD=change_me_delivery_source
DELIVERY_RANDOM_SEED=20260910
DELIVERY_SHIPMENT_COUNT=25000
DELIVERY_BATCH_MEMORY=1GB
DELIVERY_ICEBERG_PREFIX=iceberg/delivery_ops
DELIVERY_MINIO_BUCKET=mini-cybet-delivery
DELIVERY_LAKEKEEPER_WAREHOUSE=delivery-ops

# Copying is not required: `make up` creates .env with random local secrets.
# Values below are documentation only and are never consumed as credentials.
COMPOSE_PROJECT_NAME=kest
KEST_TIMEZONE=Asia/Ho_Chi_Minh

# Optional notification target. Leave empty to log failures only.
PLATFORM_ALERT_WEBHOOK_URL=

# Resource defaults for the 12 CPU / 16 GiB reference host.
CLICKHOUSE_MEMORY_LIMIT=4g
AIRFLOW_WORKER_CONCURRENCY=3
SUPERSET_WORKERS=2

# Generated automatically by `make up`; names shown for external secret-store mapping.
S3_ADMIN_ACCESS_KEY=
S3_ADMIN_SECRET_KEY=
S3_WRITER_ACCESS_KEY=
S3_WRITER_SECRET_KEY=
S3_READER_ACCESS_KEY=
S3_READER_SECRET_KEY=
S3_BACKUP_ACCESS_KEY=
S3_BACKUP_SECRET_KEY=
